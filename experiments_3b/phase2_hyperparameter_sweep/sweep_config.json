{
  "sweep_name": "3b_hyperparameter_optimization",
  "description": "Optimize masking/zeroing hyperparameters specifically for Qwen2.5-3B capacity",
  "model": "Qwen/Qwen2.5-3B-Instruct",
  "base_config": {
